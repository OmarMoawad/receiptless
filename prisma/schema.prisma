// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReceiptSource {
  QR
  PHOTO
  MANUAL
  NFC
  BLUETOOTH
  EMAIL
  POS_API
}

enum Category {
  GROCERIES
  DINING
  TRANSPORT
  UTILITIES
  HEALTH
  SHOPPING
  ENTERTAINMENT
  TRAVEL
  EDUCATION
  OTHER
}

// UNVERIFIED: manual entry or a photo with no merchant confirmation.
// IMPORTED: parsed from an external source (email forward) we didn't validate against the merchant.
// MERCHANT_VERIFIED: pushed directly by the merchant/terminal via the receipt API — authoritative.
// Signature-based cryptographic verification is a later phase; this field is the seed of that ladder.
enum VerificationLevel {
  UNVERIFIED
  IMPORTED
  MERCHANT_VERIFIED
}

// Session 2 (RECEIPTLESS_STATE.md): username + password accounts,
// cookie-based sessions — chosen over IDent's bearer-token pattern because
// this is a same-origin Next.js app (IDent's apps/web and apps/api are
// cross-origin, which is the only reason it needed bearer tokens at all).
// No AMK/vault-key concept the way IDent's Identity Core has one —
// receiptless isn't client-side E2E encrypted (see RECEIPTLESS_STATE.md's
// "Known open decisions" for whether that should change later).
model User {
  id                     String                 @id @default(cuid())
  username               String                 @unique
  passwordHash           String
  createdAt              DateTime               @default(now())
  sessions               Session[]
  receipts               Receipt[]
  inboundEmailAddress    InboundEmailAddress?
  inboundEmailDeliveries InboundEmailDelivery[]
  emailConnections       EmailConnection[]
  categoryRules          CategoryRule[]

  // Session 7: the currency this user's reports are expressed in. Every
  // conversion targets it, and a receipt already in it is never converted
  // at all.
  reportingCurrency String   @default("USD")
  fxRates           FxRate[]

  // Phase 3 Session 1: a User becomes a merchant-side actor purely through
  // memberships — no second account type, no second password. These are the
  // reverse sides of the merchant-tenancy relations; they add no columns to
  // User, so the migration that introduces them stays additive.
  merchantMemberships MerchantMembership[]
  merchantAuditEvents MerchantAuditEvent[]
}

model InboundEmailAddress {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  mailboxToken String   @unique
  createdAt    DateTime @default(now())
}

// Only the sha256 hash of the bearer session-cookie value is stored — the
// raw value is set on the cookie once, at issuance, and can't be recovered
// from this table. Same shape as IDent's identity/session.ts convention.
model Session {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Merchant {
  id        String    @id @default(cuid())
  // Unique by display name for now — a simplification. Real-world merchants
  // with multiple locations/franchises will need a MerchantLocation model
  // once POS integrations (ROADMAP.md) make location data available.
  name      String    @unique
  website   String?
  createdAt DateTime  @default(now())
  receipts  Receipt[]

  // Phase 3 Session 1: at most one merchant *account* (the administrative
  // tenancy boundary) claims a given canonical Merchant. Optional because
  // the vast majority of Merchant rows are ones consumers imported and no
  // one has claimed.
  account   MerchantAccount?
}

// --- Phase 3 Session 1: Merchant tenancy (ROADMAP.md Phase 3) ------------
//
// A merchant account is a thin administrative boundary around one *newly
// created* canonical Merchant. Existing imported Merchant rows cannot be
// claimed by name — a business proving it owns "Starbucks" is a later,
// verified onboarding concern, not a race to POST the name first. Existing
// User authentication is reused; a person acts on a merchant only through a
// membership, and every capability is decided by that membership's role.

enum MerchantRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model MerchantAccount {
  id         String   @id @default(cuid())
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  createdAt  DateTime @default(now())

  memberships MerchantMembership[]
  locations   MerchantLocation[]
  auditEvents MerchantAuditEvent[]
}

model MerchantMembership {
  id        String       @id @default(cuid())
  accountId String
  account   MerchantAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MerchantRole
  createdAt DateTime     @default(now())

  // One membership per (account, user): a person holds exactly one role in
  // an account, changed in place rather than accumulated.
  @@unique([accountId, userId])
  @@index([userId])
}

model MerchantLocation {
  id          String   @id @default(cuid())
  accountId   String
  account     MerchantAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // The merchant's own identifier for this location (store number, POS
  // terminal group). Unique within the account so a later POS ingestion can
  // map an incoming location to exactly one row.
  externalId  String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, externalId])
  @@index([accountId])
}

// Append-only. The service writes one row per privileged action; database
// triggers reject UPDATE and DELETE so the trail cannot be rewritten from
// the application at all, matching the "append-only audit" discipline the
// consumer side already applies elsewhere.
model MerchantAuditEvent {
  id          String   @id @default(cuid())
  accountId   String
  account     MerchantAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String
  // The user who performed the action, when there was one. Nullable and
  // SetNull so deleting a user never deletes their history — the row stays,
  // the actor pointer clears.
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
}

model Receipt {
  id         String   @id @default(cuid())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  merchantId String

  // Session 3 (RECEIPTLESS_STATE.md): null until claimed. A merchant-pushed
  // receipt (see /api/merchant/receipts) is created with no owner and is
  // invisible to any user's list/search until someone claims it via
  // /api/claim/[token] while authenticated, which sets this atomically with
  // claimedAt and never lets it be reassigned afterward (see src/lib/claim.ts).
  owner   User?   @relation(fields: [ownerId], references: [id])
  ownerId String?

  currency String @default("USD")

  // All money fields are integer minor units (cents) — never float — so
  // totals, sums, and reports don't accumulate rounding error.
  subtotalMinor Int?
  taxMinor      Int?
  discountMinor Int?
  feeMinor      Int?
  totalMinor    Int

  category    Category @default(OTHER)
  purchasedAt DateTime

  source       ReceiptSource     @default(MANUAL)
  verification VerificationLevel @default(UNVERIFIED)

  // Claim-token protocol: a merchant/terminal can create a receipt server-side
  // and hand the customer only an opaque, expiring token (via QR, link, etc.)
  // instead of embedding receipt data directly in the transfer medium.
  claimToken          String?   @unique
  claimTokenExpiresAt DateTime?
  claimedAt           DateTime?

  // Session 4 (RECEIPTLESS_STATE.md): replaces Phase 0's inline
  // data:image/* URL storage. Never a public URL — src/lib/storage.ts
  // only ever hands out short-lived signed URLs, gated by an
  // ownership-scoped lookup on this Receipt (see /api/receipts/[id]/photo).
  imageKey   String?
  rawPayload String?
  notes      String?

  items                ReceiptItem[]
  inboundEmailDelivery InboundEmailDelivery?
  conversions          ReceiptConversion[]

  /// Full-text search document: merchant name (weight A), item names (B),
  /// notes (C). Maintained by database triggers — see the
  /// 20260819100000_add_receipt_search_vector migration — because items are
  /// inserted after their receipt, so no application-side write could keep
  /// it correct without remembering to. Unsupported: Prisma has no tsvector
  /// type, and it is only ever read through raw SQL in lib/search.ts.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchasedAt])
  @@index([category])
  @@index([merchantId])
  @@index([ownerId])
}

// Session 9: an OAuth-connected mailbox scanned for receipts, the second
// email-ingestion path alongside Session 6's forward-to address. Token
// material is stored only as one opaque AES-256-GCM blob (see
// lib/oauth-token-crypto.ts) — never as readable columns, and never
// returned by any route.
model EmailConnection {
  id                   String    @id @default(cuid())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  provider             String
  // Google's stable account id, so reconnecting the same mailbox updates
  // this row instead of creating a duplicate connection.
  providerAccountId    String
  providerAccountEmail String?
  status               String    @default("pending")
  encryptedTokenData   String?
  // Where the last scan finished, so a re-scan doesn't re-walk the whole
  // mailbox. Gmail's internalDate of the newest message already seen.
  lastScannedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
}

// Single-use CSRF/PKCE challenge for an OAuth connect flow. The callback
// is an anonymous top-level redirect carrying no session, so `state` is
// the only thing tying it back to the user who started it.
model OAuthConnectChallenge {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  state        String    @unique
  pkceVerifier String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([userId])
}

model InboundEmailDelivery {
  id                String   @id @default(cuid())
  provider          String
  providerMessageId String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  receipt           Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  receiptId         String?  @unique
  // Which receipt-adapters/ format adapter parsed this delivery. Ingestion
  // metadata, deliberately kept here rather than on Receipt: it records how
  // receiptless read the email, not anything the merchant attested.
  adapterId         String?
  createdAt         DateTime @default(now())

  // Review findings #6/#7. A delivery whose total could not be parsed
  // still wrote this row — which is correct for idempotency and was
  // wrong for everything else: the row marks the message seen, the Gmail
  // cursor moves past it, and a better parser can never revisit it. The
  // message was silently unreachable for good.
  //
  // "imported" — a receipt exists (receiptId is set).
  // "unparsed" — no total could be read; retained for reprocessing.
  // "discarded" — reprocessing gave up, or the owner said it is not a
  //               receipt. Kept as a tombstone so it is not re-fetched.
  status        String    @default("imported")
  failureReason String?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?

  /**
   * The message itself, retained **only** while status is "unparsed", so
   * a later parser can be run against it without re-fetching from Gmail
   * (which forwarded mail could not do at all — Postmark keeps nothing).
   * Cleared the moment it parses or is discarded, so this is a work
   * queue, not an archive of everything anyone ever sent.
   */
  retainedEmail Json?

  @@unique([provider, providerMessageId])
  @@index([userId])
  @@index([status])
}

model ReceiptItem {
  id        String  @id @default(cuid())
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId String

  name     String
  sku      String?
  category Category @default(OTHER)

  quantity        Float @default(1)
  unitPriceMinor  Int
  totalPriceMinor Int
  taxMinor        Int?
  discountMinor   Int?

  // Lightweight seed for the warranty/return layer — a full claims workflow
  // is a later phase, but capturing these at ingestion time means the data
  // exists once that phase is built instead of needing backfill.
  warrantyMonths   Int?
  returnWindowDays Int?

  @@index([receiptId])
  @@index([name])
}

// Fixed-window rate limit counters. One row per (bucket, subject) pair,
// reused for the life of that pair.
//
// The design is shared with IDent (`apps/api/src/rate-limit/`), not just
// similar to it: the same bucket names, the same limits, the same single
// atomic UPSERT, the same 429 + Retry-After shape. One external review
// raised "no rate limiting" against both repos and asked for one approach
// across both, and two designs for one property is how the two repos
// drift.
//
// In Postgres rather than in memory because this app runs on Vercel:
// every request may land on a different instance, so a per-process
// counter would limit nothing at all.
//
// Deliberately holds no identifying data beyond what it must — a subject
// is an IP or a *hash* of a session token, never the token itself. A dump
// of this table is a list of counters, not a set of credentials.
model RateLimitCounter {
  bucket      String
  subject     String
  // Start of the current window; moves forward only when it expires.
  windowStart DateTime @default(now())
  count       Int      @default(0)

  @@id([bucket, subject])
  // Supports the periodic prune, which deletes by age across all buckets.
  @@index([windowStart])
}

// Session 6. A person's own classification rules, which always beat the
// built-in defaults in src/lib/categories.ts — a default that is wrong for
// someone's spending should be overridden, not argued with.
//
// `pattern` is matched as a normalised substring, never as a regular
// expression: a user-authored regex is a denial-of-service vector
// evaluated over every item of every receipt, and "why did this rule
// fire?" should be answerable by reading the rule. See categories.ts.
model CategoryRule {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  pattern  String
  category Category
  target   RuleTarget

  // Lower runs first. Owner rules default below DEFAULT_RULES' 1000 so a
  // new rule outranks the built-ins without anyone having to know that.
  priority Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One rule per pattern per target per owner: re-adding a pattern should
  // edit the rule that exists rather than create a second one that can
  // never fire.
  @@unique([ownerId, target, pattern])
  @@index([ownerId])
}

enum RuleTarget {
  MERCHANT
  ITEM
}

// Session 7 (RECEIPTLESS_STATE.md): the rate table.
//
// A rate is quote-currency units for ONE unit of base currency, stored as
// canonical decimal *text* — never a float. See lib/fx/decimal.ts for why
// text: a rate has more significant digits than a double holds exactly,
// and the error is multiplied by every amount it touches.
//
// Rows are append-only. A correction does not update a rate, it inserts a
// replacement pointing at the row it supersedes, so the history of what
// this app believed a rate was stays intact. Two partial unique indexes
// (see the migration) enforce at most one *active* row per key — one for
// an owner's manual rate, one per provider source — so the resolver can
// never silently pick whichever row was fetched last.
model FxRate {
  id String @id @default(cuid())

  // Null for a provider rate, which is shared. Set for a manual rate,
  // which is tenant-owned: one person's correction must never move
  // another person's historical conversion.
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?

  base          String
  quote         String
  effectiveDate DateTime @db.Date

  rate                String
  /// "manual", or a provider id once step 4 of the session lands.
  source              String
  sourcePolicyVersion String

  // Provenance, sufficient to audit why this rate was the one chosen.
  fetchedAt         DateTime?
  enteredAt         DateTime?
  actorUserId       String?
  reason            String?
  providerReference String?

  supersedesId String?   @unique
  supersedes   FxRate?   @relation("FxRateSupersedes", fields: [supersedesId], references: [id])
  supersededBy FxRate?   @relation("FxRateSupersedes")
  supersededAt DateTime?

  createdAt DateTime @default(now())

  conversions ReceiptConversion[]

  @@index([ownerId, base, quote, effectiveDate])
  @@index([base, quote, effectiveDate])
}

// Session 7: the immutable snapshot of one conversion of one receipt.
//
// The receipt copies the rate rather than pointing at a live lookup, so a
// revised series, a corrected rate, or a provider disappearing entirely
// can never retroactively change what a past purchase cost. `fxRateId` is
// provenance, not a dependency — every field needed to reproduce the
// arithmetic is duplicated here on purpose.
//
// Corrections are versions, not edits: a reprocessing run inserts a new
// row with `parentId` pointing at the one it replaces and flips `approved`.
// A partial unique index allows one approved row per receipt, and every
// superseded version is retained.
model ReceiptConversion {
  id        String  @id @default(cuid())
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId String

  version  Int
  parentId String?            @unique
  parent   ReceiptConversion? @relation("ConversionLineage", fields: [parentId], references: [id])
  child    ReceiptConversion? @relation("ConversionLineage")
  /// Reports select on this. Exactly one approved version per receipt.
  approved Boolean            @default(true)

  sourceCurrency          String
  targetCurrency          String
  sourceScale             Int
  targetScale             Int
  currencyMetadataVersion String

  rate                    String
  rateSource              String
  rateEffectiveDate       DateTime @db.Date
  ratePolicyVersion       String
  conversionPolicyVersion String

  /// The intermediate value before money rounding, so the rounding is
  /// auditable rather than taken on trust.
  unroundedResult  String
  totalTargetMinor Int

  fxRate   FxRate? @relation(fields: [fxRateId], references: [id])
  fxRateId String?

  operator      String?
  reason        String?
  correlationId String?

  createdAt DateTime @default(now())

  @@unique([receiptId, version])
  @@index([receiptId])
}
