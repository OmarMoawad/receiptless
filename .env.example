DATABASE_URL="postgresql://receiptless:receiptless@localhost:5433/receiptless"

# Session 6: Postmark inbound processing. Use the unique inbound address
# Postmark assigns until a custom forwarding domain is configured.
POSTMARK_INBOUND_ADDRESS="yourhash@inbound.postmarkapp.com"
POSTMARK_WEBHOOK_USERNAME="replace-me"
POSTMARK_WEBHOOK_PASSWORD="replace-me"

# Session 4 (RECEIPTLESS_STATE.md): object storage for receipt photos.
# Defaults below match docker-compose.yml's local MinIO service — same
# convention as DATABASE_URL above. For a real S3/R2 bucket, point
# S3_ENDPOINT at it (a real bucket's own regional endpoint, or R2's
# account-specific endpoint) and set real credentials.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="receiptless-dev"
S3_ACCESS_KEY_ID="receiptless"
S3_SECRET_ACCESS_KEY="receiptless-dev-secret"

# Session 5 follow-up (RECEIPTLESS_STATE.md): the self-hosted Surya OCR
# service (ocr-service/, docker-compose.yml's `ocr` service).
OCR_SERVICE_URL="http://localhost:8868"

# Session 8: the unauthenticated merchant/POS simulation endpoint is
# disabled automatically in any deployed environment (see
# src/lib/deployment.ts and DEPLOYMENT.md). Leave this unset in
# production; set it to exactly "true" only for a deliberate demo.
MERCHANT_API_ENABLED=
