{
  "compilerOptions": {
    // Session 7 raised this from ES2017. Exchange-rate arithmetic uses
    // bigint literals (see lib/fx/decimal.ts), and BigInt is ES2020.
    // Every runtime this app targets — Node 20+, and the browsers Next 16
    // supports — has had BigInt for years; ES2017 was the create-next-app
    // default rather than a constraint anything here depends on.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
